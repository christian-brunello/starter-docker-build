[Unit]
Description=Shared MySQL server (compute_rack + STARTER)
Documentation=file:///usr/local/share/doc/starter-docker/mysql-server-README.md
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/mysql-server
ExecStartPre=/bin/bash -c 'test -n "${MYSQL_SERVER_DIR:-}" && test -f "${MYSQL_SERVER_DIR}/docker-compose.yml"'
ExecStartPre=/bin/bash -c 'test -n "${MYSQL_DATA_DIR:-}" && test -d "${MYSQL_DATA_DIR}"'
ExecStartPre=/bin/bash -c 'test -n "${MYSQL_ROOT_PASSWORD:-}"'
ExecStartPre=/bin/bash -c 'docker network inspect rack-net >/dev/null 2>&1 || docker network create rack-net'
ExecStart=/bin/bash -c 'export MYSQL_DATA_DIR MYSQL_ROOT_PASSWORD MYSQL_RACK_PASSWORD; exec /usr/bin/docker compose -p mysql-server -f "${MYSQL_SERVER_DIR}/docker-compose.yml" up -d'
ExecStop=/bin/bash -c 'exec /usr/bin/docker compose -p mysql-server -f "${MYSQL_SERVER_DIR}/docker-compose.yml" stop'
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
