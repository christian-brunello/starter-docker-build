[Unit]
Description=STARTER explain daemon (host) — voice explanations via RAG/TTS
Documentation=file:///usr/local/share/doc/starter-docker/explain-README.md
After=network-online.target explain-stack.service starter-docker.service
Wants=network-online.target explain-stack.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/starter-explain
ExecStartPre=/bin/bash -c 'test -x /usr/local/bin/starter-explain || test -x /usr/bin/starter-explain'
ExecStartPre=/bin/bash -c 'test -n "${STEX_CONFIG:-}" && test -f "${STEX_CONFIG}"'
ExecStart=/bin/bash -c 'BIN=$(command -v starter-explain); exec "$BIN" --config="${STEX_CONFIG}"'
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
